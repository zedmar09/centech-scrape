# Required Flexepos/Centech credentials
FMS_USERNAME=
FMS_PASSWORD=

# Required on Vercel/serverless deployments that use Browserless or another
# remote browser. Leave blank only when the host runs Chromium locally.
FLEXEPOS_PLAYWRIGHT_WS_ENDPOINT=
FLEXEPOS_PLAYWRIGHT_CONNECT_MODE=cdp

# Required when Laravel calls the private server-to-server scraper endpoints.
# Use the same long random value in Laravel and Vercel.
FLEXEPOS_SCRAPER_API_TOKEN=

# Optional sales scraper tuning. Defaults are designed for Browserless free tier
# (two client workers, up to six store/date jobs per sub-minute session).
# FLEXEPOS_CSD_URL=https://fms.flexepos.com/FlexeposWeb/reports/netsuite.seam?cid=29099
# FLEXEPOS_SALES_JOBS_PER_SESSION=6
# Separate Flexepos logins inside each Browserless connection. Use 1 to disable.
# FLEXEPOS_CONTEXTS_PER_BROWSER=3
# FLEXEPOS_ROYALTY_URL=https://fms.flexepos.com/FlexeposWeb/royalty.seam?cid=268311

# Optional: override the committed store list in src/config/flexepos.config.json
# for a short test run.
# STORE_NUMBERS=2006,2016
