# Payroll scrape mode:
# - flexepos runs the Centech/Flexepos login + payroll report flow.
# - fetch/playwright are generic single-page URL-template modes.
PAYROLL_SCRAPER_SOURCE=flexepos

# Flexepos/Centech credentials
FMS_USERNAME=
FMS_PASSWORD=

# Default production store list from the Centech env.txt review.
# The frontend uses this list for queued scrape runs.
STORE_NUMBERS=2006,2016,2017,2020,2023,2024,2047,4003,4004,4005,4008,4009,4010,4015,4021,4025,4027,4034,4036,4042,4052,4061,4074,4083,5042,5043,5049,5051,5057,5059,5062,5101,5112,5127,6021,6026,6032,6037,6039,6044,6065,6067,6072,6074,6076,6083,6088,6093,6094,6102,7024,7032,7039,7049,7066,13026,13062,13082,13106,13116,13138,13148,13160,13162,13219,37001,37002,37004,37006,37007,37009,37010,37013,37014,37016,37020,49001,49002,49003,49004,49005,49006,49007,49008,49009,49010,49011

# Flexepos navigation
FLEXEPOS_BASE_URL=https://fms.flexepos.com/FlexeposWeb/
FLEXEPOS_LOGIN_PATH=home.seam
FLEXEPOS_PAYROLL_LINK_TEXT=Payroll
FLEXEPOS_TIP_BREAKDOWN_LINK_TEXT=Tip Breakdown Report
FLEXEPOS_LOGGED_IN_SELECTOR=a:has-text('Logout')
FLEXEPOS_NAVIGATION_TIMEOUT_MS=90000
FLEXEPOS_NAVIGATION_WAIT_UNTIL=commit
FLEXEPOS_NAVIGATION_RETRIES=2
FLEXEPOS_TIMEOUT_MS=30000
FLEXEPOS_WAIT_BEFORE_ACTION_MS=500
FLEXEPOS_WAIT_AFTER_ACTION_MS=1500
FLEXEPOS_TIP_BREAKDOWN_SUBMIT_WAIT_AFTER_MS=3000
FLEXEPOS_HEADLESS=true

# Flexepos selectors copied from the existing Centech scraper config.
FLEXEPOS_USERNAME_SELECTOR=#login\\:username
FLEXEPOS_PASSWORD_SELECTOR=#login\\:password
FLEXEPOS_LOGIN_SUBMIT_SELECTOR=form#login input[type='submit']
FLEXEPOS_STORE_SELECTOR=input[name='parameters:store']
FLEXEPOS_START_DATE_SELECTOR=input[name='parameters:startDateCalendarInputDate']
FLEXEPOS_END_DATE_SELECTOR=input[name='parameters:endDateCalendarInputDate']
FLEXEPOS_OVERTIME_SELECTOR=input[name='parameters:j_id55']
FLEXEPOS_SUBMIT_SELECTOR=input[value='Submit']
FLEXEPOS_PAYROLL_TABLE_SELECTOR=table

# Vercel/staging browser automation.
# Recommended for Vercel: install playwright-core and set this to a remote browser
# websocket/CDP endpoint from your browser provider.
FLEXEPOS_PLAYWRIGHT_WS_ENDPOINT=
FLEXEPOS_PLAYWRIGHT_CONNECT_MODE=cdp

# Optional generic URL-template scraper mode.
PAYROLL_SCRAPER_URL_TEMPLATE=https://payroll.example.com/stores/{storeNumber}/payroll
PAYROLL_SCRAPER_READY_SELECTOR=table
PAYROLL_SCRAPER_TIMEOUT_MS=30000
PAYROLL_SCRAPER_COOKIE=
PAYROLL_SCRAPER_HEADERS_JSON={}

# Optional backend payload save target.
PAYROLL_PAYLOAD_SAVE_URL=
PAYROLL_PAYLOAD_SAVE_TOKEN=
